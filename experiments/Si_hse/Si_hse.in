&CONTROL
    calculation     = 'scf'
    restart_mode    = 'from_scratch'
    pseudo_dir      = './'
    outdir          = './outdir'
/
&SYSTEM
    ecutwfc         = 40
    celldm(1)       = 10.410909236
    ntyp            = 1
    nat             = 2
    nbnd            = 8
    ibrav           = 2
    input_dft       ='hse'
    nqx1            = 2
    nqx2            = 2
    nqx3            = 2
    x_gamma_extrapolation = .TRUE.
    exxdiv_treatment = 'gygi-baldereschi'
/
&ELECTRONS
    conv_thr        = 1.0e-8
    exx_maxstep     = 1
/

